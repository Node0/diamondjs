{
  "name": "diamondjs-monorepo",
  "version": "2.3.0",
  "private": true,
  "description": "DiamondJS - JavaScript framework for LLM-assisted development",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Node0/diamondjs.git"
  },
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @diamondjs/primafacie && npm run build -w @diamondjs/runtime && npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "check-loc": "tsx tools/check-loc-budget.ts",
    "stink:check": "tsx tools/stink-check.ts",
    "stink:update": "tsx tools/stink-check.ts --update",
    "route-check": "tsx tools/route-check.ts",
    "check-meta": "tsx tools/check-meta-versions.ts",
    "typecheck": "tsc --noEmit -p packages/runtime/tsconfig.typetest.json",
    "clean": "npm run clean --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "prepublishOnly": "npm run check-loc && npm run stink:check && npm run build && npm run test",
    "test:lifecycle": "vitest run packages/runtime/tests/lifecycle && vitest run -c vitest.legacy.config.ts",
    "test:acceptance": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
